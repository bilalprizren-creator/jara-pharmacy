{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jara-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5200", "--strictPort"],
      "port": 5200,
      "autoPort": false
    },
    {
      "name": "jara-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "5300", "--strictPort"],
      "port": 5300,
      "autoPort": false
    },
    {
      "name": "jara-kontroll",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/catalog/preview-server.mjs"],
      "port": 5400,
      "autoPort": false
    }
  ]
}

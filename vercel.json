{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/barnatore-ne-prizren", "destination": "/barnatore-ne-prizren/index.html" },
    { "source": "/keshilla/:slug", "destination": "/keshilla/:slug/index.html" },
    { "source": "/lokacionet/:id", "destination": "/lokacionet/:id/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jara-pharmacy.vercel.app" }],
      "destination": "https://jara-pharmacy.com/$1",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 15
    }
  },
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/barnatore-ne-prizren", "destination": "/barnatore-ne-prizren/index.html" },
    { "source": "/keshilla/:slug", "destination": "/keshilla/:slug/index.html" },
    { "source": "/lokacionet/:id", "destination": "/lokacionet/:id/index.html" },
    { "source": "/info/:slug", "destination": "/info/:slug/index.html" },
    { "source": "/porosia", "destination": "/porosia/index.html" },
    { "source": "/porosia/:id", "destination": "/porosia/index.html" }
  ]
}

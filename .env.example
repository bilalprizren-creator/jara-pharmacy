# Jara Pharmacy — shop backend (api/). Copy to .env.local for `npm run dev`;
# in the cloud these are Vercel project environment variables (Preview =
# sandbox credentials, Production = live credentials).

# Postgres (Neon). Empty in development = orders go to .orders-dev/orders.json.
DATABASE_URL=

# mock      → no bank; api/payments/mock stands in for the payment page (dev)
# sandbox   → RaiAccept with sandbox credentials + test cards (preview)
# production→ RaiAccept live (main / jara-pharmacy.com only)
RAIACCEPT_MODE=mock
RAIACCEPT_USERNAME=
RAIACCEPT_PASSWORD=

# Resend. Empty = mails are logged, not sent. Sender must be a verified domain.
RESEND_API_KEY=
ORDER_MAIL_FROM="Jara Pharmacy <porosite@jara-pharmacy.com>"
ORDER_NOTIFY_EMAIL=jarapharm@gmail.com

# Public origin used in redirect/webhook/email URLs. Only needed locally: on
# Vercel, production falls back to https://jara-pharmacy.com and previews to
# their own VERCEL_URL automatically.
SITE_URL=http://localhost:5200

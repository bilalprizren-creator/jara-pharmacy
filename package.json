{
  "name": "jara-pharmacy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Jara Pharmacy — modern bilingual (AL/EN) pharmacy, health & beauty web app for Prizren, Kosovo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-leaflet": "^4.2.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "_browserslistComment": "Drives autoprefixer. Without an explicit list it defaults to roughly the two newest Safari releases, which strips -webkit-backdrop-filter — Safari only understands backdrop-filter unprefixed from 18 on, so the frosted header silently lost its blur on iOS 15-17. Safari/iOS 15 is the real floor anyway (aspect-ratio).",
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "Safari >= 15",
    "iOS >= 15"
  ],
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
